APP_DIR=/workspace/repos/aemo-negative-prices
PIPELINE_ARGS=--months-back 2
RUN_TESTS=1
PUSH_CHANGES=1
RUN_RAW_CACHE_PRUNE=1
RAW_CACHE_RETENTION_DAYS=120
COMMIT_MESSAGE_PREFIX=Update negative price analysis
# Only for a deliberate, audited rewrite of settled months (passed to
# --allow-history-rewrite and recorded in the commit message). Leave unset.
# HISTORY_REWRITE_REASON=
